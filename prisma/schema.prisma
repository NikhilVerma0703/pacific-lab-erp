// Pacific Surfaces — Lab ERP
//
// The central record is LabSample. Everything a sample "is made of" hangs off it
// through child tables, never through comma-separated strings:
//
//   LabSample ─┬─ Formulation (role = MAIN_BODY | DESIGN_ROY_BODY | VEIN_ROY_BODY …)
//              │     └─ FormulationComponent (kind = RESIN | GRIT | FILLER | PIGMENT)
//              ├─ SampleDesignPattern   (many-to-many → MasterValue)
//              ├─ SampleVeinMethod      (many-to-many → MasterValue)
//              ├─ LabMeasurement        (stage × body → L, a, b)
//              └─ SampleAttachment      (files live in storage, not in Postgres)
//
// Every dropdown value is a MasterValue row inside a MasterCategory, so lists
// grow without schema changes, and a value used by history is disabled
// (isActive = false) rather than deleted.

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: queries run through the pg driver adapter (src/lib/db.ts).
  // Same code works locally and on Neon, and no native query engine ships.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: set DIRECT_URL to the non-pooled connection string for migrations.
  // Locally it is the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & access
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(OPERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  samplesCreated    LabSample[]          @relation("SampleCreatedBy")
  inwardCreated     InwardOutwardEntry[] @relation("InwardCreatedBy")
  inwardUpdated     InwardOutwardEntry[] @relation("InwardUpdatedBy")
  samplesUpdated    LabSample[]          @relation("SampleUpdatedBy")
  masterValuesAdded MasterValue[]        @relation("MasterValueCreatedBy")
  attachmentsAdded  SampleAttachment[]   @relation("AttachmentUploadedBy")
  auditEntries      AuditLog[]
  announcements     Announcement[]
  forumReplies      ForumReply[]         @relation("ForumReplyAuthor")
  productionCreated ProductionSample[]   @relation("ProductionCreatedBy")
  productionUpdated ProductionSample[]   @relation("ProductionUpdatedBy")
}

// ─────────────────────────────────────────────────────────────────────────────
// Master data (dynamic lookups)
// ─────────────────────────────────────────────────────────────────────────────

/// A list of selectable values: Resins, Grits, Grit Sizes, Fillers, Pigments …
/// New categories are rows here, not schema changes.
model MasterCategory {
  id          String   @id @default(cuid())
  /// Stable key the code refers to, e.g. "RESIN". Never shown to users.
  code        String   @unique
  name        String
  description String?
  /// Whether users may add values from the data-entry form ("OTHER").
  allowCustom Boolean  @default(true)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values MasterValue[]
}

model MasterValue {
  id            String   @id @default(cuid())
  categoryId    String
  /// What users see, trimmed and with single spaces.
  label         String
  /// Lower-case, whitespace-collapsed label. "Glass" and " glass " collide here.
  normalizedKey String
  /// Optional behaviour hook for values the code reacts to (e.g. ROY_BODY opens
  /// the Roy Body formulation). Labels can be renamed; codes do not change.
  code          String?
  isActive      Boolean  @default(true)
  /// Seeded by the system (still editable/disable-able, just labelled).
  isSystem      Boolean  @default(false)
  sortOrder     Int      @default(100)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  MasterCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("MasterValueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Reverse relations — they are what makes a value "in use".
  samplesAsMixer             LabSample[]                   @relation("SampleMixerType")
  componentsAsMaterial       FormulationComponent[]        @relation("ComponentMaterial")
  componentsAsSize           FormulationComponent[]        @relation("ComponentSize")
  designPatternUses          SampleDesignPattern[]
  veinMethodUses             SampleVeinMethod[]
  inwardCompanyUses          InwardOutwardEntry[]
  inwardPatternUses          InwardDesignPattern[]
  formulationsAsMixer        Formulation[]                 @relation("FormulationMixerType")
  formulationVeinUses        FormulationVeinMethod[]
  productionPatternUses      ProductionDesignPattern[]
  bodiesAsMixer              SampleBody[]                  @relation("SampleBodyMixerType")
  bodyPatternUses            SampleBodyDesignPattern[]
  bodyVeinMethodUses         SampleBodyVeinMethod[]
  inwardBodyPatternUses      InwardBodyDesignPattern[]
  productionBodyPatternUses  ProductionBodyDesignPattern[]
  samplesAsDesignName        LabSample[]                   @relation("SampleDesignName")
  inwardsAsDesignName        InwardOutwardEntry[]          @relation("InwardDesignName")
  productionsAsDesignName    ProductionSample[]            @relation("ProductionDesignName")
  bodyVeinDetailUses         SampleBodyVeinDetail[]        @relation("SampleBodyVeinDetail")
  formulationVeinDetailUses  FormulationVeinDetail[]       @relation("FormulationVeinDetail")
  inwardDesignMixerUses      InwardDesignDetail[]          @relation("InwardDesignMixerType")
  inwardDesignVeinDetailUses InwardDesignVeinDetail[]      @relation("InwardDesignVeinDetail")
  inwardDesignColourUses     InwardDesignColour[]          @relation("InwardDesignColour")
  sampleDesignMixerUses      SampleDesignDetail[]          @relation("SampleDesignMixerType")
  sampleDesignVeinDetailUses SampleDesignVeinDetail[]      @relation("SampleDesignVeinDetail")
  sampleDesignColourUses     SampleDesignColour[]          @relation("SampleDesignColour")
  formulationAdditiveUses    FormulationAdditive[]         @relation("FormulationAdditive")

  @@unique([categoryId, normalizedKey])
  @@unique([categoryId, code])
  @@index([categoryId, isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lab samples
// ─────────────────────────────────────────────────────────────────────────────

enum SampleStatus {
  DRAFT
  SUBMITTED
  // Later phases: UNDER_TEST, APPROVED, REJECTED, SENT_TO_PRODUCTION …
}

enum DesignCategory {
  PLAIN_BODY
  NON_PLAIN_BODY
}

enum MeasurementUnit {
  GRAMS
  PERCENT
}

model LabSample {
  id                    String          @id @default(cuid())
  /// S.No. — sequential, unique, assigned by the server.
  serialNo              Int             @unique
  /// Slab number — suggested as the next free number, unique when present.
  slabNumber            Int?            @unique
  sampleDate            DateTime        @db.Date
  status                SampleStatus    @default(SUBMITTED)
  /// Design Name — a value of the Design Names master list.
  designNameId          String?
  /// Design Name typed as free text before it became a master list. `npm run
  /// db:seed` moves it into the list (and saving the sample does too).
  legacyDesignName      String?         @map("designName")
  numberOfBodies        Int?
  designCategory        DesignCategory?
  mixerTypeId           String?
  hasVein               Boolean?
  veinNotes             String?
  remarks               String?
  /// Physical Sample Available? Yes → recorded in Inward / Outward;
  /// No → listed under Rectification in Inward / Outward.
  physicalSamplePresent Boolean?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mixerType       MasterValue? @relation("SampleMixerType", fields: [mixerTypeId], references: [id], onDelete: Restrict)
  designNameValue MasterValue? @relation("SampleDesignName", fields: [designNameId], references: [id], onDelete: Restrict)
  createdBy       User?        @relation("SampleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?        @relation("SampleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  formulations   Formulation[]
  designPatterns SampleDesignPattern[]
  veinMethods    SampleVeinMethod[]
  measurements   LabMeasurement[]
  attachments    SampleAttachment[]
  inwardEntry    InwardOutwardEntry?
  /// Body 1 … n: each body's design and vein (its formulations and L/a/b
  /// carry the same bodyIndex). Samples saved before bodies existed have
  /// none — their sample-level design / vein apply to every body.
  bodies         SampleBody[]
  /// Plain Body – No: the selected design types with their own fields.
  designDetails  SampleDesignDetail[]
  /// Lab Sample Database: the complete copy of this sample.
  record         LabSampleRecord?

  @@index([sampleDate])
  @@index([status])
  @@index([createdAt])
  @@index([physicalSamplePresent])
  @@index([designNameId])
}

/// Which body of the sample a formulation describes. One reusable structure
/// serves the main body, the Roy Body opened from Design, the Roy Body opened
/// from Vein, and any body type added later.
enum FormulationRole {
  /// Material Details of Body i (bodyIndex = i).
  MAIN_BODY
  /// Earlier form: the Roy Body opened from Body i's Design (bodyIndex = i).
  DESIGN_ROY_BODY
  /// Earlier form: the Roy Body opened from a Vein.
  VEIN_ROY_BODY
  /// Rebuilt Lab Sample form: Material Details of Roy Body k (bodyIndex = k).
  ROY_BODY
  /// Rebuilt Lab Sample form: Material Details of Chessboard Body k (bodyIndex = k).
  CHESSBOARD_BODY
}

/// Belongs to exactly one owner: a lab sample OR an inward/outward entry
/// (enforced in the service layer) — or, for the Roy Body opened from a Roy
/// Body's own Vein, to its parent formulation. New owners add one nullable FK.
///
/// A Roy Body (role DESIGN_ROY_BODY) is a complete body of its own: besides
/// its components it carries Number of Bodies, Vein details (with Mixer Type)
/// and L/a/b readings.
model Formulation {
  id            String          @id @default(cuid())
  sampleId      String?
  inwardEntryId String?
  parentId      String?
  role          FormulationRole
  /// Reserved for per-body formulations (Body 1, Body 2 …). 1 today.
  bodyIndex     Int             @default(1)
  notes         String?

  // Roy Body details (unused for plain formulations)
  numberOfBodies  Int?
  hasVein         Boolean?
  /// Vein details typed as free text before the Vein Details list existed
  /// (moved into the list on first use / `npm run db:seed`).
  legacyVeinNotes String?  @map("veinNotes")
  mixerTypeId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sample       LabSample?               @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  inwardEntry  InwardOutwardEntry?      @relation(fields: [inwardEntryId], references: [id], onDelete: Cascade)
  parent       Formulation?             @relation("NestedFormulation", fields: [parentId], references: [id], onDelete: Cascade)
  children     Formulation[]            @relation("NestedFormulation")
  mixerType    MasterValue?             @relation("FormulationMixerType", fields: [mixerTypeId], references: [id], onDelete: Restrict)
  components   FormulationComponent[]
  additives    FormulationAdditive[]
  veinMethods  FormulationVeinMethod[]
  veinDetails  FormulationVeinDetail[]
  measurements FormulationMeasurement[]

  @@unique([sampleId, role, bodyIndex])
  @@unique([inwardEntryId, role, bodyIndex])
  @@index([parentId])
}

model FormulationVeinMethod {
  formulationId String
  methodId      String
  sortOrder     Int    @default(0)

  formulation Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  method      MasterValue @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@id([formulationId, methodId])
  @@index([methodId])
}

/// Vein details of a Roy Body — values of the Vein Details list.
model FormulationVeinDetail {
  formulationId String
  detailId      String
  sortOrder     Int    @default(0)

  formulation Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  detail      MasterValue @relation("FormulationVeinDetail", fields: [detailId], references: [id], onDelete: Restrict)

  @@id([formulationId, detailId])
  @@index([detailId])
}

/// L / a / b of a Roy Body — same stage × body structure as the sample's.
model FormulationMeasurement {
  id            String           @id @default(cuid())
  formulationId String
  stage         MeasurementStage
  bodyIndex     Int
  l             Decimal?         @db.Decimal(8, 3)
  a             Decimal?         @db.Decimal(8, 3)
  b             Decimal?         @db.Decimal(8, 3)

  formulation Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)

  @@unique([formulationId, stage, bodyIndex])
}

enum ComponentKind {
  RESIN
  GRIT
  FILLER
  PIGMENT
}

model FormulationComponent {
  id            String           @id @default(cuid())
  formulationId String
  kind          ComponentKind
  /// The resin / grit / filler / pigment, from its master list.
  materialId    String?
  /// Grit size (GRIT rows only).
  sizeId        String?
  unit          MeasurementUnit?
  quantity      Decimal?         @db.Decimal(14, 4)
  sortOrder     Int              @default(0)

  formulation Formulation  @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  material    MasterValue? @relation("ComponentMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  size        MasterValue? @relation("ComponentSize", fields: [sizeId], references: [id], onDelete: Restrict)

  @@index([formulationId, kind])
  @@index([materialId])
}

/// Additives used in a formulation (Additives list) and the quantity in grams.
model FormulationAdditive {
  id            String   @id @default(cuid())
  formulationId String
  additiveId    String
  quantity      Decimal? @db.Decimal(14, 4)
  sortOrder     Int      @default(0)

  formulation Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  additive    MasterValue @relation("FormulationAdditive", fields: [additiveId], references: [id], onDelete: Restrict)

  @@unique([formulationId, additiveId])
  @@index([additiveId])
}

/// One selected design type of a lab sample (Plain Body – No), with the
/// fields that type has — same shape as InwardDesignDetail:
///  - Roy Body / Chessboard: Number of Roy Body / Chessboard Body (n); their
///    Material Details are Formulation ROY_BODY / CHESSBOARD_BODY 1 … n
///  - Kreos / Vein: Vein Present, and when Yes: Mixer Type, Vein Details,
///    colours used with quantity
///  - Carrara: colours used with quantity
model SampleDesignDetail {
  id          String     @id @default(cuid())
  sampleId    String
  type        DesignType
  bodyCount   Int?
  veinPresent Boolean?
  mixerTypeId String?

  sample      LabSample                @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  mixerType   MasterValue?             @relation("SampleDesignMixerType", fields: [mixerTypeId], references: [id], onDelete: Restrict)
  veinDetails SampleDesignVeinDetail[]
  colours     SampleDesignColour[]

  @@unique([sampleId, type])
  @@index([mixerTypeId])
}

model SampleDesignVeinDetail {
  designDetailId String
  detailId       String
  sortOrder      Int    @default(0)

  designDetail SampleDesignDetail @relation(fields: [designDetailId], references: [id], onDelete: Cascade)
  detail       MasterValue        @relation("SampleDesignVeinDetail", fields: [detailId], references: [id], onDelete: Restrict)

  @@id([designDetailId, detailId])
  @@index([detailId])
}

model SampleDesignColour {
  id             String   @id @default(cuid())
  designDetailId String
  colourId       String
  quantity       Decimal? @db.Decimal(14, 4)
  sortOrder      Int      @default(0)

  designDetail SampleDesignDetail @relation(fields: [designDetailId], references: [id], onDelete: Cascade)
  colour       MasterValue        @relation("SampleDesignColour", fields: [colourId], references: [id], onDelete: Restrict)

  @@unique([designDetailId, colourId])
  @@index([colourId])
}

model SampleDesignPattern {
  sampleId  String
  patternId String
  sortOrder Int    @default(0)

  sample  LabSample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  pattern MasterValue @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@id([sampleId, patternId])
  @@index([patternId])
}

model SampleVeinMethod {
  sampleId  String
  methodId  String
  sortOrder Int    @default(0)

  sample LabSample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  method MasterValue @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@id([sampleId, methodId])
  @@index([methodId])
}

/// One body of a lab sample (Body 1 … n): its Design and Vein. The body's
/// Material Choices (Formulation MAIN_BODY), Roy Bodies and L/a/b readings
/// share its bodyIndex.
model SampleBody {
  id              String          @id @default(cuid())
  sampleId        String
  bodyIndex       Int
  designCategory  DesignCategory?
  mixerTypeId     String?
  hasVein         Boolean?
  /// Vein details typed as free text before the Vein Details list existed
  /// (moved into the list on first use / `npm run db:seed`).
  legacyVeinNotes String?         @map("veinNotes")

  sample         LabSample                 @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  mixerType      MasterValue?              @relation("SampleBodyMixerType", fields: [mixerTypeId], references: [id], onDelete: Restrict)
  designPatterns SampleBodyDesignPattern[]
  veinMethods    SampleBodyVeinMethod[]
  veinDetails    SampleBodyVeinDetail[]

  @@unique([sampleId, bodyIndex])
  @@index([mixerTypeId])
}

model SampleBodyDesignPattern {
  bodyId    String
  patternId String
  sortOrder Int    @default(0)

  body    SampleBody  @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  pattern MasterValue @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@id([bodyId, patternId])
  @@index([patternId])
}

model SampleBodyVeinMethod {
  bodyId    String
  methodId  String
  sortOrder Int    @default(0)

  body   SampleBody  @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  method MasterValue @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@id([bodyId, methodId])
  @@index([methodId])
}

/// Vein details of one body — values of the Vein Details list (like Color Used).
model SampleBodyVeinDetail {
  bodyId    String
  detailId  String
  sortOrder Int    @default(0)

  body   SampleBody  @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  detail MasterValue @relation("SampleBodyVeinDetail", fields: [detailId], references: [id], onDelete: Restrict)

  @@id([bodyId, detailId])
  @@index([detailId])
}

enum MeasurementStage {
  POST_PRESS
  POST_POLISH
}

/// L, a, b of a lab sample: Post Press and Post Polish per body — the
/// regular bodies (MAIN, 1 … N) and, when those design types are selected,
/// the Roy Bodies and Chessboard Bodies (1 … n each).
model LabMeasurement {
  id        String           @id @default(cuid())
  sampleId  String
  part      ReadingPart      @default(MAIN)
  stage     MeasurementStage
  bodyIndex Int
  l         Decimal?         @db.Decimal(8, 3)
  a         Decimal?         @db.Decimal(8, 3)
  b         Decimal?         @db.Decimal(8, 3)

  sample LabSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, part, stage, bodyIndex])
}

enum AttachmentPurpose {
  SAMPLE_OUTPUT
}

/// Metadata only — the bytes live in the storage driver (local disk now,
/// object storage in production) under `storageKey`.
model SampleAttachment {
  id                 String            @id @default(cuid())
  /// Null until the sample is saved; unlinked uploads are cleaned up by a job.
  /// A file belongs to one lab sample, production sample or Inward / Outward entry.
  sampleId           String?
  productionSampleId String?
  inwardEntryId      String?
  purpose            AttachmentPurpose @default(SAMPLE_OUTPUT)
  originalName       String
  storageKey         String            @unique
  mimeType           String
  sizeBytes          Int
  sha256             String
  uploadedById       String?
  createdAt          DateTime          @default(now())

  sample           LabSample?          @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  productionSample ProductionSample?   @relation(fields: [productionSampleId], references: [id], onDelete: Cascade)
  inwardEntry      InwardOutwardEntry? @relation(fields: [inwardEntryId], references: [id], onDelete: Cascade)
  uploadedBy       User?               @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([sampleId])
  @@index([productionSampleId])
  @@index([inwardEntryId])
  @@index([sha256])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Inward / Outward samples
// ─────────────────────────────────────────────────────────────────────────────

/// A physical sample received from (or sent to) a company. When it started as
/// a lab sample (Physical Sample Available? = Yes), `labSampleId` links the two.
model InwardOutwardEntry {
  id                     String          @id @default(cuid())
  /// Serial number — sequential, unique, assigned by the server.
  serialNo               Int             @unique
  /// The entry's date (defaults to the day it is recorded; can be changed).
  entryDate              DateTime        @default(now()) @db.Date
  labSampleId            String?         @unique
  companyId              String?
  /// Sample Design Name — a value of the Design Names master list.
  designNameId           String?
  /// Sample Design Name typed as free text before it became a master list
  /// (moved into the list by `npm run db:seed` or the next save).
  legacySampleDesignName String?         @map("sampleDesignName")
  /// Slab Number — Inward / Outward's own series, suggested as the next free number.
  slabNumber             Int?            @unique
  numberOfBodies         Int?
  /// Plain Body – Yes (PLAIN_BODY) / Plain Body – No (NON_PLAIN_BODY), for the whole sample.
  designCategory         DesignCategory?
  /// Recorded by the earlier form only (kept; shown on the Review page and in Downloads).
  recreationAttempts     String?
  remarks                String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labSample       LabSample?   @relation(fields: [labSampleId], references: [id], onDelete: SetNull)
  company         MasterValue? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  designNameValue MasterValue? @relation("InwardDesignName", fields: [designNameId], references: [id], onDelete: Restrict)
  createdBy       User?        @relation("InwardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?        @relation("InwardUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  designPatterns InwardDesignPattern[]
  measurements   InwardMeasurement[]
  formulations   Formulation[]
  /// Recorded by the earlier form: each body's design (its Roy Body
  /// formulation and L/a/b carry the same bodyIndex). The rebuilt form records
  /// the design for the whole sample (designCategory, designPatterns,
  /// designDetails) instead.
  bodies         InwardBody[]
  /// Plain Body – No: each selected design type and its own fields.
  designDetails  InwardDesignDetail[]
  /// Sample Inward / Outward Database: the complete copy of this entry.
  record         InwardOutwardRecord?
  /// Sample Output files.
  attachments    SampleAttachment[]

  @@index([companyId])
  @@index([designNameId])
  @@index([entryDate])
  @@index([createdAt])
}

model InwardDesignPattern {
  entryId   String
  patternId String
  sortOrder Int    @default(0)

  entry   InwardOutwardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  pattern MasterValue        @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@id([entryId, patternId])
  @@index([patternId])
}

/// One body of an Inward / Outward entry: its Design.
model InwardBody {
  id             String          @id @default(cuid())
  entryId        String
  bodyIndex      Int
  designCategory DesignCategory?

  entry          InwardOutwardEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  designPatterns InwardBodyDesignPattern[]

  @@unique([entryId, bodyIndex])
}

model InwardBodyDesignPattern {
  bodyId    String
  patternId String
  sortOrder Int    @default(0)

  body    InwardBody  @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  pattern MasterValue @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@id([bodyId, patternId])
  @@index([patternId])
}

/// One L/a/b reading per body (no Post Press / Post Polish split here).
/// L, a, b of an Inward / Outward entry: one reading per body — the regular
/// bodies (MAIN, 1 … N) and, when those design types are selected, the Roy
/// Bodies and Chessboard Bodies (1 … n each).
model InwardMeasurement {
  id        String      @id @default(cuid())
  entryId   String
  part      ReadingPart @default(MAIN)
  bodyIndex Int
  l         Decimal?    @db.Decimal(8, 3)
  a         Decimal?    @db.Decimal(8, 3)
  b         Decimal?    @db.Decimal(8, 3)

  entry InwardOutwardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, part, bodyIndex])
}

/// Which bodies a reading belongs to: the regular bodies, or the Roy /
/// Chessboard Bodies of those design types (Lab Sample, Inward / Outward).
enum ReadingPart {
  MAIN
  ROY_BODY
  CHESSBOARD
}

/// Plain Body – No: the design types a lab sample or an Inward / Outward
/// entry can carry. Each is also linked to its value in the Design Patterns
/// list (SampleDesignPattern / InwardDesignPattern), so lists, the Dashboard
/// and Downloads see it as a design pattern.
enum DesignType {
  ROY_BODY
  KREOS
  CARRARA
  VEIN
  CHESSBOARD
}

/// One selected design type of an entry, with the fields that type has:
///  - Roy Body / Chessboard: Number of Roy Body / Chessboard Body (n)
///  - Kreos / Vein: Vein Present, and when Yes: Mixer Type, Vein Details,
///    colours used with quantity
///  - Carrara: colours used with quantity
model InwardDesignDetail {
  id          String     @id @default(cuid())
  entryId     String
  type        DesignType
  bodyCount   Int?
  veinPresent Boolean?
  mixerTypeId String?

  entry       InwardOutwardEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mixerType   MasterValue?             @relation("InwardDesignMixerType", fields: [mixerTypeId], references: [id], onDelete: Restrict)
  veinDetails InwardDesignVeinDetail[]
  colours     InwardDesignColour[]

  @@unique([entryId, type])
  @@index([mixerTypeId])
}

/// Vein Details of a Kreos / Vein design type — values of the Vein Details list.
model InwardDesignVeinDetail {
  designDetailId String
  detailId       String
  sortOrder      Int    @default(0)

  designDetail InwardDesignDetail @relation(fields: [designDetailId], references: [id], onDelete: Cascade)
  detail       MasterValue        @relation("InwardDesignVeinDetail", fields: [detailId], references: [id], onDelete: Restrict)

  @@id([designDetailId, detailId])
  @@index([detailId])
}

/// A colour used by a Kreos / Carrara / Vein design type (Pigments / Colours
/// list) and its quantity in grams.
model InwardDesignColour {
  id             String   @id @default(cuid())
  designDetailId String
  colourId       String
  quantity       Decimal? @db.Decimal(14, 4)
  sortOrder      Int      @default(0)

  designDetail InwardDesignDetail @relation(fields: [designDetailId], references: [id], onDelete: Cascade)
  colour       MasterValue        @relation("InwardDesignColour", fields: [colourId], references: [id], onDelete: Restrict)

  @@unique([designDetailId, colourId])
  @@index([colourId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Production samples (received from the plant)
// ─────────────────────────────────────────────────────────────────────────────

/// Digital register of samples received from the production plant and their
/// readings. Own S.No. / Slab Number series, separate from lab samples.
model ProductionSample {
  id                String          @id @default(cuid())
  /// S.No. — sequential, unique, assigned by the server.
  serialNo          Int             @unique
  /// Slab number — suggested as the next free number, unique when present.
  slabNumber        Int?            @unique
  sampleDate        DateTime        @db.Date
  /// Design Name — a value of the Design Names master list.
  designNameId      String?
  /// Design Name typed as free text before it became a master list (moved
  /// into the list by `npm run db:seed` or the next save).
  legacyDesignName  String?         @map("designName")
  numberOfBodies    Int?
  designCategory    DesignCategory?
  /// Roy Body (opened when ROY BODY is one of the design patterns): its own
  /// Number of Bodies; its L/a/b rows are ProductionMeasurement part ROY_BODY.
  royNumberOfBodies Int?
  remarks           String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designNameValue MasterValue? @relation("ProductionDesignName", fields: [designNameId], references: [id], onDelete: Restrict)
  createdBy       User?        @relation("ProductionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?        @relation("ProductionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  designPatterns ProductionDesignPattern[]
  measurements   ProductionMeasurement[]
  attachments    SampleAttachment[]
  /// Body 1 … n: each body's design and Roy Body. Older entries have none —
  /// their entry-level design applies to every body.
  bodies         ProductionBody[]

  @@index([sampleDate])
  @@index([createdAt])
  @@index([designNameId])
}

model ProductionDesignPattern {
  productionSampleId String
  patternId          String
  sortOrder          Int    @default(0)

  productionSample ProductionSample @relation(fields: [productionSampleId], references: [id], onDelete: Cascade)
  pattern          MasterValue      @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@id([productionSampleId, patternId])
  @@index([patternId])
}

/// One body of a production sample: its Design (and its Roy Body's n).
model ProductionBody {
  id                 String          @id @default(cuid())
  productionSampleId String
  bodyIndex          Int
  designCategory     DesignCategory?
  royNumberOfBodies  Int?

  productionSample ProductionSample              @relation(fields: [productionSampleId], references: [id], onDelete: Cascade)
  designPatterns   ProductionBodyDesignPattern[]

  @@unique([productionSampleId, bodyIndex])
}

model ProductionBodyDesignPattern {
  bodyId    String
  patternId String
  sortOrder Int    @default(0)

  body    ProductionBody @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  pattern MasterValue    @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@id([bodyId, patternId])
  @@index([patternId])
}

/// Which body an L/a/b reading belongs to: the sample itself or its Roy Body.
enum ProductionBodyPart {
  MAIN
  ROY_BODY
}

/// Post Press / Post Polish L/a/b per body, for the sample and its Roy Body.
model ProductionMeasurement {
  id                 String             @id @default(cuid())
  productionSampleId String
  part               ProductionBodyPart @default(MAIN)
  /// ROY_BODY readings: the body (1 … n) whose Design opened that Roy Body.
  /// 0 for MAIN readings, and for Roy Body readings saved before bodies existed.
  ownerBody          Int                @default(0)
  stage              MeasurementStage
  bodyIndex          Int
  l                  Decimal?           @db.Decimal(8, 3)
  a                  Decimal?           @db.Decimal(8, 3)
  b                  Decimal?           @db.Decimal(8, 3)

  productionSample ProductionSample @relation(fields: [productionSampleId], references: [id], onDelete: Cascade)

  @@unique([productionSampleId, part, ownerBody, stage, bodyIndex])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dashboard: Forum (posts + threaded replies)
// ─────────────────────────────────────────────────────────────────────────────

enum AnnouncementKind {
  TASK
  INSTRUCTION
  QUERY
  ANNOUNCEMENT
  PRODUCTION
  OTHER
}

enum PostStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

/// Forum post — an instruction, task, query or announcement from the Lab Head /
/// Plant Head / CEO. Lab and R&D users reply underneath (ForumReply).
/// Removing a post archives it (kept for the record), it is never deleted.
/// (Table name kept as "Announcement" so existing posts carry over.)
model Announcement {
  id             String           @id @default(cuid())
  kind           AnnouncementKind @default(ANNOUNCEMENT)
  title          String
  message        String
  /// Priority today is Normal / Important (pinned). Room for more levels later.
  important      Boolean          @default(false)
  status         PostStatus       @default(OPEN)
  isArchived     Boolean          @default(false)
  /// Name typed by the poster while sign-in is off; otherwise the user's name.
  authorName     String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  /// Moves forward with every new reply, so active threads come to the top.
  lastActivityAt DateTime         @default(now())

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  replies   ForumReply[]

  @@index([isArchived, lastActivityAt])
  @@index([status])
}

/// A reply in a post's thread. Removing one hides it (soft delete) so the
/// thread keeps its shape.
model ForumReply {
  id          String   @id @default(cuid())
  postId      String
  message     String
  authorName  String?
  createdById String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post      Announcement @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ForumReplyAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only trail. A deleted sample's full record survives here as JSON.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  summary    String?
  snapshot   Json?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Separate record databases (Lab Sample Database, Sample Inward / Outward
// Database). Every saved record is also stored here as one complete,
// self-contained copy — Basic / Sample Details, design (Plain Body, design
// types and their fields), Material Details, all L, a, b readings, files and
// remarks — rewritten on every save and removed when the record is deleted.
// The registers keep reading the forms' own tables; these copies are for
// using the records on their own (e.g. Lab Sample suggestions from existing
// physical samples). Labels in `data` are as at the last save; every value
// also carries its id.
// ─────────────────────────────────────────────────────────────────────────────

model LabSampleRecord {
  sampleId       String       @id
  serialNo       Int
  slabNumber     Int?
  sampleDate     DateTime     @db.Date
  designNameId   String?
  designName     String?
  plainBody      Boolean?
  designTypes    DesignType[]
  numberOfBodies Int?
  /// Shape of `data` (bumped if the form changes).
  formVersion    Int          @default(1)
  /// The whole record (SampleDetail).
  data           Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sample LabSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleDate])
  @@index([designNameId])
}

model InwardOutwardRecord {
  entryId        String       @id
  serialNo       Int
  slabNumber     Int?
  entryDate      DateTime     @db.Date
  companyId      String?
  company        String?
  designNameId   String?
  designName     String?
  plainBody      Boolean?
  designTypes    DesignType[]
  numberOfBodies Int?
  /// Shape of `data` (bumped if the form changes).
  formVersion    Int          @default(1)
  /// The whole record (InwardDetail).
  data           Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entry InwardOutwardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryDate])
  @@index([designNameId])
}
