# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL (Windows service, no Docker) — put your postgres password
# in both lines. The database itself is created by `npx prisma db push`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pacific_lab_erp?schema=public"
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct one.
# Locally both are the same.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pacific_lab_erp?schema=public"

# ── Users ───────────────────────────────────────────────────────────────────
# Sign-in is OFF for now: everyone works as this one built-in Admin user, and
# records are saved as "created by" this name. `npm run db:seed` creates it
# (the password is kept for when sign-in is switched back on).
SEED_ADMIN_EMAIL="admin@pacific-surfaces.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Lab Admin"

# For when sign-in returns (Auth.js). Not used while sign-in is off.
AUTH_SECRET="change-me-to-a-long-random-string"

# ── File storage ────────────────────────────────────────────────────────────
# "local" stores uploads under STORAGE_LOCAL_DIR. An object-storage driver
# (S3 / R2 / Vercel Blob) plugs into src/lib/storage without touching callers.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# Per-file limit in MB.
UPLOAD_MAX_MB="15"

# ── Background jobs (Inngest) ───────────────────────────────────────────────
# Nothing to set locally. To run the scheduled jobs on your PC, start
# `npm run inngest:dev` next to `npm run dev`. In production set
# INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from the Inngest dashboard.

# Plant time zone — "today" for new samples.
APP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
